      "html": "<label class=\"ds-amount\"><input class=\"ds-input\" inputmode=\"decimal\" placeholder=\"0,00\"><span>€</span></label>",
      "css": ".ds-amount{position:relative;display:block;width:260px}.ds-amount span{position:absolute;right:12px;top:50%;transform:translateY(-50%);color:var(--muted-foreground,oklch(0.5 0.01 75));font:14px Geist,system-ui,sans-serif}.ds-input{box-sizing:border-box;width:100%;height:40px;padding:4px 32px 4px 12px;border:1px solid var(--input,oklch(0.88 0.006 85));border-radius:var(--radius,12px);background:var(--card,#fff);color:var(--foreground,oklch(0.2 0.008 75));font:14px Geist,system-ui,sans-serif;font-variant-numeric:tabular-nums;box-shadow:0 1px 1px oklch(0.4 0.02 75/0.03);transition:border-color .15s,box-shadow .15s}.ds-input:focus-visible{outline:none;border-color:oklch(0.55 0.11 160);box-shadow:0 0 0 3px oklch(0.55 0.11 160/0.25)}"
    },
