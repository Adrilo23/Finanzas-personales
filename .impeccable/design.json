      "html": "<button class=\"ds-btn-primary\">Guardar movimiento</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;height:36px;padding:0 14px;border:1px solid transparent;border-radius:var(--radius,12px);background:var(--primary,oklch(0.22 0.009 75));color:var(--primary-foreground,oklch(0.985 0.002 85));font:500 14px/1 Geist,system-ui,sans-serif;box-shadow:inset 0 1px 0 oklch(1 0 0/0.12);cursor:pointer;transition:transform .15s ease-out,opacity .15s ease-out}.ds-btn-primary:hover{opacity:.88}.ds-btn-primary:active{transform:scale(.97)}.ds-btn-primary:focus-visible{outline:none;box-shadow:0 0 0 3px oklch(0.55 0.11 160/0.4)}"
    },
    {
